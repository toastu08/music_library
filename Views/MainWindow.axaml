<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:music_library.ViewModels"
        xmlns:models="using:music_library.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="music_library.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="music_library">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Root grid: playlist area on top (*), playback bar pinned to the bottom (Auto).
         The playback bar sits OUTSIDE the SplitView, so opening the pane never covers it. -->
    <Grid RowDefinitions="*,Auto">

        <!-- ================= SplitView ================= -->
        <SplitView Grid.Row="0"
                   DisplayMode="CompactInline"
                   IsPaneOpen="{Binding IsPaneOpen}"
                   OpenPaneLength="330">

            <SplitView.Pane>
                <ScrollViewer>
                    <StackPanel Spacing="8" Margin="8">
                        <!-- Open / close the pane (command not wired yet) -->
                        <Button Content="☰" HorizontalAlignment="Stretch" Command="{Binding TogglePaneCommand}"/>
                        <!-- Import a music source (no functionality yet) -->
                        <Button Content="+" HorizontalAlignment="Stretch" Command="{Binding SelectFolderCommand}" CommandParameter="{Binding $parent[Window]}"/>
                        <!-- Save/load the library as JSON -->
                        <Button Content="Save" HorizontalAlignment="Stretch" Command="{Binding SaveLibraryCommand}"/>
                        <Button Content="Load" HorizontalAlignment="Stretch" Command="{Binding LoadLibraryCommand}"/>
                        <Button Content="PloyLoopTest" HorizontalAlignment="Stretch" Command="{Binding DescribeAllCommand}"/>

                        <!-- S7 queries -->
                        <TextBlock Text="Queries" FontWeight="Bold" Margin="0,8,0,0"/>
                        <Button Content="Most played artist" HorizontalAlignment="Stretch" Command="{Binding ShowMostPlayedArtistCommand}"/>
                        <Button Content="Hours by genre" HorizontalAlignment="Stretch" Command="{Binding ShowHoursPerGenreCommand}"/>
                        <Button Content="Never played" HorizontalAlignment="Stretch" Command="{Binding ShowNeverPlayedCommand}"/>
                        <Button Content="Longest album" HorizontalAlignment="Stretch" Command="{Binding ShowLongestAlbumCommand}"/>
                        <Button Content="Top decade" HorizontalAlignment="Stretch" Command="{Binding ShowTopDecadeCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </SplitView.Pane>

            <SplitView.Content>
                <!-- Song names of the current playlist, top to bottom -->
                <ListBox ItemsSource="{Binding SongLibrary}"
                 Margin="12"
                 SelectedItem="{Binding SelectedAudio, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Audio">
                            <TextBlock Text="{Binding}" Padding="4,6"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </SplitView.Content>
        </SplitView>

        <!-- ================= Bottom playback bar =================
             transport buttons (~1/5) - position slider (~3/5) - volume slider (~1/5) -->
        <Border Grid.Row="1"
                Padding="12,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="1*,3*,1*">

                <!-- Transport buttons (previous / play-pause / next) -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <Button Content="Previous" Command="{Binding PlayPreviousCommand}"/>
                    <Button Content="Play/Pause" Command="{Binding TogglePauseCommand}"/>
                    <Button Content="Next" Command="{Binding PlayNextCommand}"/>
                </StackPanel>

                <!-- Horizontal slider: playback position (will bind to the media engine timestamp) -->
                <Slider Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="12,0"
                        Minimum="0"
                        Maximum="100"/>

                <!-- Vertical slider: volume (will bind to the media engine volume) -->
                <Slider Grid.Column="2"
                        Orientation="Vertical"
                        HorizontalAlignment="Center"
                        Height="48"
                        Minimum="0"
                        Maximum="100"/>

            </Grid>
        </Border>

        <!-- ================= Query result popup ================= -->
        <Border Grid.RowSpan="2"
                IsVisible="{Binding IsQueryResultOpen}"
                Background="#80000000">
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    MaxWidth="600"
                    MaxHeight="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Text="{Binding QueryResultTitle}"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <ScrollViewer Grid.Row="1" Margin="0,12">
                        <TextBlock Text="{Binding QueryResultBody}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <Button Grid.Row="2"
                            Content="Close"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseQueryResultCommand}"/>
                </Grid>
            </Border>
        </Border>

    </Grid>

</Window>
